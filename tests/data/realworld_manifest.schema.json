{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://malaz.invalid/schemas/realworld_manifest.schema.json",
  "title": "Malaz Realwelt-Manifest",
  "description": "Metadaten und SHA-256-Werte des Realwelt-Korpus. Enthält KEINE Proben und keine Payload-Daten. Die Python-Validierung in src/malaz/lab/manifest.py muss zu diesem Schema passen.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus", "files"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "created", "source"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "created": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "name",
        "type",
        "family",
        "label",
        "source",
        "first_seen",
        "split",
        "notes"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "description": "SHA-256 der Probe, kleingeschrieben, 64 Hex-Zeichen.",
          "pattern": "^[0-9a-f]{64}$"
        },
        "name": {
          "type": "string",
          "description": "Reiner Dateiname ohne Pfadanteile.",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^\\u0000-\\u001f\\u007f/\\\\]+$",
          "not": {
            "enum": [".", ".."]
          }
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,31}$"
        },
        "family": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "label": {
          "enum": ["malicious", "benign"]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "first_seen": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "split": {
          "enum": ["dev", "test"]
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        }
      }
    }
  }
}
